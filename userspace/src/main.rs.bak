mod syscall;
mod sdk;
mod framework;
pub mod png;
pub mod apps;

use std::fs;
use framework::*;

const SCREEN_W: usize = 1920;
const SCREEN_H: usize = 1080;

pub fn is_valid_truetype_font(data: &[u8]) -> bool {
    if data.len() < 12 { return false; }
    let magic = &data[0..4];
    if magic == b"OTTO" {
        return false;
    }
    if magic != &[0x00, 0x01, 0x00, 0x00] && magic != b"true" {
        return false;
    }
    let num_tables = u16::from_be_bytes([data[4], data[5]]) as usize;
    let mut off = 12;
    for _ in 0..num_tables {
        if off + 16 > data.len() { return false; }
        let tag = &data[off..off + 4];
        let table_off = u32::from_be_bytes([data[off + 8], data[off + 9], data[off + 10], data[off + 11]]) as usize;
        let table_len = u32::from_be_bytes([data[off + 12], data[off + 13], data[off + 14], data[off + 15]]) as usize;
        if tag == b"head" {
            if table_off + 20 <= data.len() && table_len >= 54 {
                let upem = u16::from_be_bytes([data[table_off + 18], data[table_off + 19]]);
                return upem >= 16 && upem <= 16384;
            }
        }
        off += 16;
    }
    false
}

fn try_read_font(paths: &[&str]) -> Vec<u8> {
    for p in paths {
        if let Ok(data) = fs::read(p) {
            if !data.is_empty() {
                if is_valid_truetype_font(&data) {
                    println!("[FONT] Loaded valid TrueType font from: {}", p);
                    return data;
                } else {
                    println!("[FONT] Skipped incompatible OTF/CFF font: {}", p);
                }
            }
        }
    }
    Vec::new()
}

fn main() {
    println!("🚀 Launching EOS macOS Desktop (Ring 3 Userspace)...");

    let font_paths = [
        "/EOS SHARE/fonts/SFPRODISPLAYREGULAR.TTF",
        "/EOS SHARE/fonts/SFPRODISPLAYREGULAR.OTF",
        "/RootFS/fonts/SFPRODISPLAYREGULAR.TTF",
        "/RootFS/fonts/SFPRODISPLAYREGULAR.OTF",
        "SFPRODISPLAYREGULAR.TTF",
        "SFPRODISPLAYREGULAR.OTF",
    ];

    let font_bytes = try_read_font(&font_paths);
    let mut app = FrameworkApp::new(&font_bytes, SCREEN_W, SCREEN_H);

    app.spawn_app("Finder");
    app.spawn_app("Terminal");

    app.set_dock_handler(|_idx| {});
    app.run_loop();
}
