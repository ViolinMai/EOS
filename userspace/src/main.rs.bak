mod syscall;
mod sdk;
mod framework;
mod apps;

use std::fs;
use framework::*;
use apps::*;

const SCREEN_W: usize = 1920;
const SCREEN_H: usize = 1080;

fn main() {
    println!("🚀 Launching EOS macOS Desktop (Ring 3 Userspace)...");

    let font_bytes = fs::read("/EOS SHARE/fonts/SFPRODISPLAYREGULAR.OTF")
        .or_else(|_| fs::read("/RootFS/fonts/SFPRODISPLAYREGULAR.OTF"))
        .unwrap_or_default();

    let mut app = FrameworkApp::new(&font_bytes, SCREEN_W, SCREEN_H);

    app.add_widget(Box::new(WindowFrame::new("Finder", 120, 70, 760, 480, Box::new(FinderApp::new()))));
    app.add_widget(Box::new(WindowFrame::new("Terminal", 200, 140, 640, 420, Box::new(TerminalApp::new()))));
    app.add_widget(Box::new(WindowFrame::new("TextEdit", 280, 210, 600, 400, Box::new(TextEditApp::new()))));
    app.add_widget(Box::new(WindowFrame::new("Preview", 320, 100, 500, 400, Box::new(PreviewApp::new("/sample.png")))));

    app.set_dock_handler(|idx| {
        println!("Dock clicked: {}", idx);
    });

    app.run_loop();
}
