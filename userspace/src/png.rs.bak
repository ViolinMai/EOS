use std::io::Cursor;
use crate::{f_info, f_error};

pub fn decode_png(data: &[u8]) -> Result<(Vec<u32>, usize, usize), String> {
    let t_start = std::time::Instant::now();
    let cursor = Cursor::new(data);
    let mut decoder = png::Decoder::new(cursor);

    // إلغاء قيد الـ 64MB الافتراضي للسماح بفك ضغط الصور الضخمة
    decoder.set_limits(png::Limits { bytes: usize::MAX });

    let mut reader = decoder.read_info().map_err(|e| format!("Failed to parse PNG header: {:?}", e))?;
    let t_header = t_start.elapsed();

    let info = reader.info();
    let width = info.width as usize;
    let height = info.height as usize;
    let color_type = info.color_type;
    let bit_depth = info.bit_depth;

    let buf_size = reader.output_buffer_size().ok_or_else(|| "Failed to calculate output buffer size".to_string())?;
    f_info!(
        "PNG",
        "[1/3] Header Parsed in {:?}: {}x{} px | Color: {:?} | Depth: {:?} | Uncompressed: {:.2} MB",
        t_header, width, height, color_type, bit_depth, (buf_size as f64) / (1024.0 * 1024.0)
    );

    let t_inflate_start = std::time::Instant::now();
    let mut raw_buf = vec![0u8; buf_size];
    let output_info = reader.next_frame(&mut raw_buf).map_err(|e| format!("next_frame error: {:?}", e))?;
    let t_inflate = t_inflate_start.elapsed();
    f_info!("PNG", "[2/3] Frame Decompression (zlib inflate) finished in {:?}", t_inflate);

    let t_conv_start = std::time::Instant::now();
    let total_pixels = width * height;
    let mut pixels = vec![0u32; total_pixels];

    match output_info.color_type {
        png::ColorType::Rgba => {
            for i in 0..total_pixels {
                let o = i * 4;
                if o + 3 < raw_buf.len() {
                    pixels[i] = ((raw_buf[o + 3] as u32) << 24)
                        | ((raw_buf[o] as u32) << 16)
                        | ((raw_buf[o + 1] as u32) << 8)
                        | (raw_buf[o + 2] as u32);
                }
            }
        }
        png::ColorType::Rgb => {
            for i in 0..total_pixels {
                let o = i * 3;
                if o + 2 < raw_buf.len() {
                    pixels[i] = (0xFF << 24)
                        | ((raw_buf[o] as u32) << 16)
                        | ((raw_buf[o + 1] as u32) << 8)
                        | (raw_buf[o + 2] as u32);
                }
            }
        }
        png::ColorType::Grayscale => {
            for i in 0..total_pixels {
                if i < raw_buf.len() {
                    let v = raw_buf[i] as u32;
                    pixels[i] = (0xFF << 24) | (v << 16) | (v << 8) | v;
                }
            }
        }
        png::ColorType::GrayscaleAlpha => {
            for i in 0..total_pixels {
                let o = i * 2;
                if o + 1 < raw_buf.len() {
                    let v = raw_buf[o] as u32;
                    let a = raw_buf[o + 1] as u32;
                    pixels[i] = (a << 24) | (v << 16) | (v << 8) | v;
                }
            }
        }
        png::ColorType::Indexed => {
            let err = "Indexed PNG palette not supported".to_string();
            f_error!("PNG", "{}", err);
            return Err(err);
        }
    }

    let t_conv = t_conv_start.elapsed();
    let total_time = t_start.elapsed();
    f_info!(
        "PNG",
        "[3/3] Pixel Formatting (ARGB8888) finished in {:?}. Total Decode Time: {:?}",
        t_conv, total_time
    );

    Ok((pixels, width, height))
}
