use std::io::Cursor;

pub fn decode_png(data: &[u8]) -> Result<(Vec<u32>, usize, usize), &'static str> {
    let cursor = Cursor::new(data);
    let decoder = png::Decoder::new(cursor);
    let mut reader = decoder.read_info().map_err(|_| "Failed to parse PNG header")?;
    let mut raw_buf = vec![0u8; reader.output_buffer_size()];
    let output_info = reader.next_frame(&mut raw_buf).map_err(|_| "Failed to decode PNG frame")?;

    let width = output_info.width as usize;
    let height = output_info.height as usize;
    let total_pixels = width * height;
    let mut pixels = vec![0u32; total_pixels];

    match output_info.color_type {
        png::ColorType::Rgba => {
            for i in 0..total_pixels {
                let o = i * 4;
                if o + 3 < raw_buf.len() {
                    pixels[i] = ((raw_buf[o + 3] as u32) << 24)
                        | ((raw_buf[o] as u32) << 16)
                        | ((raw_buf[o + 1] as u32) << 8)
                        | (raw_buf[o + 2] as u32);
                }
            }
        }
        png::ColorType::Rgb => {
            for i in 0..total_pixels {
                let o = i * 3;
                if o + 2 < raw_buf.len() {
                    pixels[i] = (0xFF << 24)
                        | ((raw_buf[o] as u32) << 16)
                        | ((raw_buf[o + 1] as u32) << 8)
                        | (raw_buf[o + 2] as u32);
                }
            }
        }
        png::ColorType::Grayscale => {
            for i in 0..total_pixels {
                if i < raw_buf.len() {
                    let v = raw_buf[i] as u32;
                    pixels[i] = (0xFF << 24) | (v << 16) | (v << 8) | v;
                }
            }
        }
        png::ColorType::GrayscaleAlpha => {
            for i in 0..total_pixels {
                let o = i * 2;
                if o + 1 < raw_buf.len() {
                    let v = raw_buf[o] as u32;
                    let a = raw_buf[o + 1] as u32;
                    pixels[i] = (a << 24) | (v << 16) | (v << 8) | v;
                }
            }
        }
        png::ColorType::Indexed => {
            return Err("Indexed PNG color type not supported");
        }
    }

    Ok((pixels, width, height))
}
