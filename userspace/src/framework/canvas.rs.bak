use std::collections::BTreeMap;
use rusttype::{Font, Scale, point};
use super::widget::Rect;

pub struct Canvas<'a> {
    pub buffer: &'a mut [u32],
    pub width: usize,
    pub height: usize,
    pub clip_stack: Vec<Rect>,
    font: Option<&'a Font<'a>>,
    font_cache: &'a mut BTreeMap<(usize, char), (usize, usize, isize, isize, usize, Vec<u8>)>,
}

impl<'a> Canvas<'a> {
    pub fn new(
        buffer: &'a mut [u32],
        width: usize,
        height: usize,
        font: Option<&'a Font<'a>>,
        font_cache: &'a mut BTreeMap<(usize, char), (usize, usize, isize, isize, usize, Vec<u8>)>,
    ) -> Self {
        Self {
            buffer,
            width,
            height,
            clip_stack: Vec::new(),
            font,
            font_cache,
        }
    }

    #[inline(always)]
    pub fn blend(bg: u32, fg: u32, alpha: u32) -> u32 {
        if alpha >= 255 { return fg | 0xFF000000; }
        if alpha == 0 { return bg | 0xFF000000; }
        let inv = 255 - alpha;
        let rb = (((fg & 0x00FF00FF) * alpha + (bg & 0x00FF00FF) * inv) >> 8) & 0x00FF00FF;
        let g = (((fg & 0x0000FF00) * alpha + (bg & 0x0000FF00) * inv) >> 8) & 0x0000FF00;
        0xFF000000 | rb | g
    }

    pub fn push_clip(&mut self, rect: Rect) {
        if let Some(&top) = self.clip_stack.last() {
            let intersect = top.intersect(&rect);
            self.clip_stack.push(intersect);
        } else {
            let base = Rect::new(0, 0, self.width, self.height).intersect(&rect);
            self.clip_stack.push(base);
        }
    }

    pub fn pop_clip(&mut self) {
        self.clip_stack.pop();
    }

    pub fn current_clip(&self) -> Rect {
        self.clip_stack.last().copied().unwrap_or(Rect::new(0, 0, self.width, self.height))
    }

    pub fn measure_text(&mut self, text: &str, size: usize) -> (usize, usize) {
        let mut width = 0;
        for c in text.chars() {
            if c == '\n' || c == '\r' { continue; }
            if is_custom_bitmap_char(c) || self.font.is_none() {
                let scale_factor = (size / 10).max(1);
                width += get_sugoi_advance(c) * scale_factor;
                continue;
            }

            let key = (size, c);
            if let Some(entry) = self.font_cache.get(&key) {
                width += entry.4;
                continue;
            }

            let font = self.font.unwrap();
            let glyph = font.glyph(c);
            let glyph_id = glyph.id().0;

            if glyph_id == 0 {
                let scale_factor = (size / 10).max(1);
                let adv = get_sugoi_advance(c) * scale_factor;
                self.font_cache.insert(key, (0, 0, 0, 0, adv, Vec::new()));
                width += adv;
            } else {
                let scale = Scale::uniform(size as f32);
                let scaled = glyph.scaled(scale);
                let adv = scaled.h_metrics().advance_width.round().max(1.0) as usize;
                self.font_cache.insert(key, (0, 0, 0, 0, adv, Vec::new()));
                width += adv;
            }
        }
        (width, size)
    }

    pub fn draw_rect(&mut self, x: usize, y: usize, w: usize, h: usize, color: u32, radius: usize) {
        let clip = self.current_clip();
        let sx = x.max(clip.x);
        let sy = y.max(clip.y);
        let ex = (x + w).min(clip.x + clip.w);
        let ey = (y + h).min(clip.y + clip.h);
        if sx >= ex || sy >= ey { return; }

        if radius == 0 {
            for cy in sy..ey {
                let row = cy * self.width;
                for cx in sx..ex {
                    self.buffer[row + cx] = color | 0xFF000000;
                }
            }
        } else {
            let r_sq = (radius * radius) as isize;
            for cy in sy..ey {
                let row = cy * self.width;
                let is_top = cy < y + radius;
                let is_bottom = cy >= (y + h).saturating_sub(radius);
                let dy = if is_top { (y + radius - 1) as isize - cy as isize } else if is_bottom { cy as isize - (y + h - radius) as isize } else { 0 };

                for cx in sx..ex {
                    let is_left = cx < x + radius;
                    let is_right = cx >= (x + w).saturating_sub(radius);
                    if (is_top || is_bottom) && (is_left || is_right) {
                        let dx = if is_left { (x + radius - 1) as isize - cx as isize } else { cx as isize - (x + w - radius) as isize };
                        if dx * dx + dy * dy > r_sq { continue; }
                    }
                    self.buffer[row + cx] = color | 0xFF000000;
                }
            }
        }
    }

    pub fn draw_rect_outline(&mut self, x: usize, y: usize, w: usize, h: usize, color: u32, radius: usize) {
        if w == 0 || h == 0 { return; }
        if radius == 0 {
            self.draw_line_h(x, y, w, color);
            self.draw_line_h(x, y + h.saturating_sub(1), w, color);
            self.draw_line_v(x, y, h, color);
            self.draw_line_v(x + w.saturating_sub(1), y, h, color);
            return;
        }

        let clip = self.current_clip();
        let sx = x.max(clip.x);
        let sy = y.max(clip.y);
        let ex = (x + w).min(clip.x + clip.w);
        let ey = (y + h).min(clip.y + clip.h);
        if sx >= ex || sy >= ey { return; }

        let r_outer = radius as isize;
        let r_inner = (radius.saturating_sub(1)) as isize;
        let ro_sq = r_outer * r_outer;
        let ri_sq = r_inner * r_inner;

        for cy in sy..ey {
            let row = cy * self.width;
            let is_top = cy < y + radius;
            let is_bottom = cy >= (y + h).saturating_sub(radius);
            let dy = if is_top { (y + radius - 1) as isize - cy as isize } else if is_bottom { cy as isize - (y + h - radius) as isize } else { 0 };

            for cx in sx..ex {
                let is_left = cx < x + radius;
                let is_right = cx >= (x + w).saturating_sub(radius);

                if (is_top || is_bottom) && (is_left || is_right) {
                    let dx = if is_left { (x + radius - 1) as isize - cx as isize } else { cx as isize - (x + w - radius) as isize };
                    let dist = dx * dx + dy * dy;
                    if dist <= ro_sq && dist >= ri_sq {
                        self.buffer[row + cx] = color | 0xFF000000;
                    }
                } else if cy == y || cy == y + h - 1 || cx == x || cx == x + w - 1 {
                    self.buffer[row + cx] = color | 0xFF000000;
                }
            }
        }
    }

    pub fn draw_line_h(&mut self, x: usize, y: usize, w: usize, color: u32) {
        self.draw_rect(x, y, w, 1, color, 0);
    }

    pub fn draw_line_v(&mut self, x: usize, y: usize, h: usize, color: u32) {
        self.draw_rect(x, y, 1, h, color, 0);
    }

    fn draw_bitmap_glyph(&mut self, cur_x: usize, y: usize, c: char, color: u32, size: usize, clip: Rect) -> usize {
        let scale = (size / 10).max(1);
        let glyph = get_sugoi_glyph(c);
        for gy in 0..16 {
            let byte = glyph[gy];
            for gx in 0..8 {
                if (byte & (1 << (7 - gx))) != 0 {
                    for dy in 0..scale {
                        for dx in 0..scale {
                            let px = cur_x + gx * scale + dx;
                            let py = y + gy * scale + dy;
                            if px >= clip.x && px < clip.x + clip.w && py >= clip.y && py < clip.y + clip.h {
                                self.buffer[py * self.width + px] = color | 0xFF000000;
                            }
                        }
                    }
                }
            }
        }
        get_sugoi_advance(c) * scale
    }

    pub fn draw_text(&mut self, x: usize, y: usize, text: &str, color: u32, size: usize) {
        let clip = self.current_clip();
        let mut cur_x = x;

        for c in text.chars() {
            if c == '\n' { cur_x = x; continue; }
            if c == '\r' { continue; }

            if is_custom_bitmap_char(c) || self.font.is_none() {
                cur_x += self.draw_bitmap_glyph(cur_x, y, c, color, size, clip);
                continue;
            }

            let font = self.font.unwrap();
            let key = (size, c);

            if !self.font_cache.contains_key(&key) {
                let glyph = font.glyph(c);
                if glyph.id().0 == 0 {
                    let adv = get_sugoi_advance(c) * (size / 10).max(1);
                    self.font_cache.insert(key, (0, 0, 0, 0, adv, Vec::new()));
                } else {
                    let scale = Scale::uniform(size as f32);
                    let v_metrics = font.v_metrics(scale);
                    let positioned = glyph.scaled(scale).positioned(point(0.0, v_metrics.ascent));
                    let adv = positioned.unpositioned().h_metrics().advance_width.round().max(1.0) as usize;

                    if let Some(bb) = positioned.pixel_bounding_box() {
                        let gw = bb.width().max(0) as usize;
                        let gh = bb.height().max(0) as usize;
                        let mut cov = vec![0u8; gw * gh];
                        positioned.draw(|gx, gy, v| {
                            let idx = gy as usize * gw + gx as usize;
                            if idx < cov.len() {
                                cov[idx] = (v * 255.0) as u8;
                            }
                        });
                        self.font_cache.insert(key, (gw, gh, bb.min.x as isize, bb.min.y as isize, adv, cov));
                    } else {
                        self.font_cache.insert(key, (0, 0, 0, 0, adv, Vec::new()));
                    }
                }
            }

            let entry = self.font_cache.get(&key).unwrap();
            let (gw, gh, bx, by, adv, cov) = (entry.0, entry.1, entry.2, entry.3, entry.4, &entry.5);

            if cov.is_empty() {
                // خط الـ TrueType/OTF لم يوفر رسمة لهذا الحرف؛ التراجع بأمان لرسام النظام
                cur_x += self.draw_bitmap_glyph(cur_x, y, c, color, size, clip);
            } else {
                let gx = (cur_x as isize + bx).max(0) as usize;
                let gy = (y as isize + by).max(0) as usize;

                for row in 0..gh {
                    let py = gy + row;
                    if py < clip.y || py >= clip.y + clip.h { continue; }
                    for col in 0..gw {
                        let px = gx + col;
                        if px < clip.x || px >= clip.x + clip.w { continue; }
                        let alpha = cov[row * gw + col] as u32;
                        if alpha > 0 {
                            let idx = py * self.width + px;
                            self.buffer[idx] = Self::blend(self.buffer[idx], color, alpha);
                        }
                    }
                }
                cur_x += adv;
            }
        }
    }
}

pub fn is_custom_bitmap_char(c: char) -> bool {
    matches!(c, '📁' | '📄' | '⚙' | '🖼' | '›' | '💾' | '' | '⚡')
}

pub fn get_sugoi_advance(c: char) -> usize {
    match c {
        ' ' => 5,
        'i' | 'l' | '!' | '|' | ':' | ';' | '.' | '\'' | '`' => 4,
        'j' | 'r' | 't' | '(' | ')' | '[' | ']' | '{' | '}' => 6,
        'm' | 'w' | 'M' | 'W' | '@' | '%' => 10,
        '📁' | '📄' | '⚙' | '🖼' | '💾' | '⚡' => 12,
        _ => 8,
    }
}

pub fn get_sugoi_glyph(c: char) -> [u8; 16] {
    match c {
        ' ' => [0x00; 16],
        '' => [0x00, 0x08, 0x14, 0x08, 0x3E, 0x7F, 0x7F, 0x7F, 0x7F, 0x7F, 0x3E, 0x1C, 0x00, 0x00, 0x00, 0x00],
        '!' => [0x00, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x00, 0x00, 0x00, 0x00],
        '"' => [0x00, 0x66, 0x66, 0x66, 0x24, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '#' => [0x00, 0x24, 0x24, 0x7E, 0x24, 0x24, 0x7E, 0x24, 0x24, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '$' => [0x00, 0x18, 0x3E, 0x60, 0x3C, 0x06, 0x7C, 0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '%' => [0x00, 0x62, 0x64, 0x08, 0x10, 0x20, 0x26, 0x46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '&' => [0x00, 0x38, 0x6C, 0x38, 0x76, 0xCE, 0xCE, 0x7B, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '\'' => [0x00, 0x18, 0x18, 0x10, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '(' => [0x00, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        ')' => [0x00, 0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '*' => [0x00, 0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '+' => [0x00, 0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        ',' => [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x10, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00],
        '-' => [0x00, 0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '.' => [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '/' => [0x00, 0x02, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '0' => [0x00, 0x3C, 0x66, 0x6E, 0x76, 0x66, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '1' => [0x00, 0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '2' => [0x00, 0x3C, 0x66, 0x06, 0x0C, 0x18, 0x30, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '3' => [0x00, 0x3C, 0x66, 0x06, 0x1C, 0x06, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '4' => [0x00, 0x0C, 0x1C, 0x34, 0x64, 0x7E, 0x04, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '5' => [0x00, 0x7E, 0x60, 0x7C, 0x06, 0x06, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '6' => [0x00, 0x1C, 0x30, 0x60, 0x7C, 0x66, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '7' => [0x00, 0x7E, 0x06, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '8' => [0x00, 0x3C, 0x66, 0x66, 0x3C, 0x66, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '9' => [0x00, 0x3C, 0x66, 0x66, 0x3E, 0x06, 0x0C, 0x38, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        ':' => [0x00, 0x00, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        ';' => [0x00, 0x00, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x10, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '<' => [0x00, 0x0C, 0x18, 0x30, 0x60, 0x30, 0x18, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '=' => [0x00, 0x00, 0x7E, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '>' => [0x00, 0x30, 0x18, 0x0C, 0x06, 0x0C, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '?' => [0x00, 0x3C, 0x66, 0x0C, 0x18, 0x18, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        '@' => [0x00, 0x3C, 0x66, 0x6E, 0x6A, 0x6E, 0x60, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'A' => [0x00, 0x18, 0x3C, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'B' => [0x00, 0x7C, 0x66, 0x66, 0x7C, 0x66, 0x66, 0x7C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'C' => [0x00, 0x3C, 0x66, 0x60, 0x60, 0x60, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'D' => [0x00, 0x78, 0x6C, 0x66, 0x66, 0x66, 0x6C, 0x78, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'E' => [0x00, 0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'F' => [0x00, 0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x60, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'G' => [0x00, 0x3C, 0x66, 0x60, 0x6E, 0x66, 0x66, 0x3E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'H' => [0x00, 0x66, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'I' => [0x00, 0x3C, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'J' => [0x00, 0x0E, 0x06, 0x06, 0x06, 0x06, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'K' => [0x00, 0x66, 0x6C, 0x78, 0x70, 0x78, 0x6C, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'L' => [0x00, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'M' => [0x00, 0x63, 0x77, 0x7F, 0x6B, 0x63, 0x63, 0x63, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'N' => [0x00, 0x66, 0x76, 0x7E, 0x7E, 0x6E, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'O' => [0x00, 0x3C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'P' => [0x00, 0x7C, 0x66, 0x66, 0x7C, 0x60, 0x60, 0x60, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'Q' => [0x00, 0x3C, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x0E, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'R' => [0x00, 0x7C, 0x66, 0x66, 0x7C, 0x6C, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'S' => [0x00, 0x3C, 0x66, 0x60, 0x3C, 0x06, 0x66, 0x3C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        'T' => [0x00, 0x7E, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
