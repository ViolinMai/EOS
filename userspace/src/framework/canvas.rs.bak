pub fn draw_cursor(&mut self, mx: usize, my: usize) {
    for cy in 0..22 {
        let py = my + cy;
        if py >= self.height { break; }
        for cx in 0..15 {
            let px = mx + cx;
            if px >= self.width { break; }
            if cx <= (cy * 2) / 3 && (cx + cy) < 24 {
                let is_border = cx == 0 || cx == (cy * 2) / 3 || (cx + cy) >= 22;
                self.buffer[py * self.width + px] = if is_border { 0xFF000000 } else { 0xFFFFFFFF };
            }
        }
    }
}
