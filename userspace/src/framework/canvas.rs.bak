        'F' => [0, 0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x60, 0, 0, 0, 0, 0, 0, 0, 0],
        'G' => [0, 0x3C, 0x66, 0x60, 0x6E, 0x66, 0x66, 0x3E, 0, 0, 0, 0, 0, 0, 0, 0],
