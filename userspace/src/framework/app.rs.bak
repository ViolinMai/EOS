use crate::framework::*;
use crate::syscall::*;
use std::time::Instant;

pub struct Window {
    pub id: usize,
    pub title: String,
    pub widget: Box<dyn Widget>,
    pub bounds: Rect,
    pub is_minimized: bool,
    pub is_maximized: bool,
    pub prev_bounds: Rect,
}

pub struct FrameworkApp {
    pub width: usize,
    pub height: usize,
    pub running: bool,
    pub windows: Vec<Window>,
    pub active_window_idx: Option<usize>,
    pub dock_apps: Vec<(&'static str, usize)>,
    pub dock_handler: Option<Box<dyn FnMut(usize)>>,
    pub dragging_window: Option<(usize, i32, i32)>,
    pub resizing_window: Option<(usize, i32, i32)>,
    pub mouse_x: i32,
    pub mouse_y: i32,
    pub last_frame_time: Instant,
    pub next_win_id: usize,
}

impl FrameworkApp {
    pub fn new(_font_data: &[u8], width: usize, height: usize) -> Self {
        Self {
            width,
            height,
            running: true,
            windows: Vec::new(),
            active_window_idx: None,
            dock_apps: vec![
                ("Finder", 0),
                ("Settings", 1),
                ("Terminal", 2),
                ("TextEdit", 3),
                ("Preview", 4),
                ("Activity Monitor", 5),
                ("Browser", 6),
            ],
            dock_handler: None,
            dragging_window: None,
            resizing_window: None,
            mouse_x: (width / 2) as i32,
            mouse_y: (height / 2) as i32,
            last_frame_time: Instant::now(),
            next_win_id: 1,
        }
    }

    pub fn set_dock_handler<F: 'static + FnMut(usize)>(&mut self, handler: F) {
        self.dock_handler = Some(Box::new(handler));
    }

    pub fn spawn_app(&mut self, name: &str) {
        let theme = get_theme();
        let default_w = theme.pt(840.0).min(self.width as i32 - 100);
        let default_h = theme.pt(560.0).min(self.height as i32 - 140);
        let offset = (self.windows.len() as i32 * 30) % 200;
        let x = theme.pt(80.0) + offset;
        let y = theme.pt(60.0) + offset;
        let bounds = Rect::new(x, y, default_w, default_h);

        let widget: Box<dyn Widget> = match name {
            "Finder" => Box::new(crate::apps::FinderApp::new()),
            "Settings" => Box::new(crate::apps::SettingsApp::new()),
            "Terminal" => Box::new(crate::apps::TerminalApp::new()),
            "TextEdit" => Box::new(crate::apps::TextEditApp::new()),
            "Activity Monitor" => Box::new(crate::apps::ActivityMonitorApp::new()),
            "Browser" => Box::new(crate::apps::BrowserApp::new()),
            _ => Box::new(crate::apps::FinderApp::new()),
        };

        let win = Window {
            id: self.next_win_id,
            title: name.to_string(),
            widget,
            bounds,
            is_minimized: false,
            is_maximized: false,
            prev_bounds: bounds,
        };
        self.next_win_id += 1;
        self.windows.push(win);
        self.active_window_idx = Some(self.windows.len() - 1);
        theme::redraw_fullscreen();
    }

    pub fn draw_dock_icon(&self, canvas: &mut Canvas, cx: i32, cy: i32, sz: i32, idx: usize) {
        let icon_sz = (sz * 3) / 4;
        let x = cx - (icon_sz / 2);
        let y = cy - (icon_sz / 2);

        let colors = [
            0xFF38BDF8, // Finder
            0xFF10B981, // Settings
            0xFF1E293B, // Terminal
            0xFFF59E0B, // TextEdit
            0xFF8B5CF6, // Preview
            0xFFEF4444, // Activity Monitor
            0xFF06B6D4, // Browser
        ];
        let col = colors[idx % colors.len()];

        canvas.draw_rect(x, y, icon_sz, icon_sz, col, 8);
        canvas.draw_rect_outline(x, y, icon_sz, icon_sz, 0xFFFFFFFF, 8);

        let inner_pad = icon_sz / 5;
        canvas.draw_rect(
            x + inner_pad,
            y + inner_pad,
            icon_sz - (inner_pad * 2),
            icon_sz - (inner_pad * 2),
            0x44FFFFFF,
            4,
        );
    }

    pub fn run_loop(&mut self) {
        let mut screen_buffer = vec![0xFF0F172A; self.width * self.height];

        while self.running {
            while let Some(ev) = sys_poll_event() {
                match ev[0] {
                    1 => {
                        let x = (ev[1] & 0xFFFFFFFF) as i32;
                        let y = ((ev[1] >> 32) & 0xFFFFFFFF) as i32;
                        self.mouse_x = x;
                        self.mouse_y = y;
                        if let Some((idx, ox, oy)) = self.dragging_window {
                            if idx < self.windows.len() {
                                self.windows[idx].bounds.x = x - ox;
                                self.windows[idx].bounds.y = y - oy;
                                theme::redraw_fullscreen();
                            }
                        }
                    }
                    2 => {
                        let pressed = ((ev[1] >> 8) & 1) != 0;
                        if pressed {
                            let theme = get_theme();
                            let dock_count = self.dock_apps.len() as i32;
                            let item_sz = theme.pt(56.0);
                            let dock_pad = theme.pt(10.0);
                            let dock_w = (dock_count * item_sz) + ((dock_count + 1) * dock_pad);
                            let dock_h = item_sz + (dock_pad * 2);
                            let dock_x = ((self.width as i32) - dock_w) / 2;
                            let dock_y = (self.height as i32) - dock_h - theme.pt(12.0);

                            if self.mouse_x >= dock_x && self.mouse_x <= dock_x + dock_w && self.mouse_y >= dock_y && self.mouse_y <= dock_y + dock_h {
                                let rel_x = self.mouse_x - dock_x - dock_pad;
                                let step = item_sz + dock_pad;
                                if rel_x >= 0 {
                                    let clicked_idx = (rel_x / step) as usize;
                                    if clicked_idx < self.dock_apps.len() {
                                        let name = self.dock_apps[clicked_idx].0;
                                        self.spawn_app(name);
                                        continue;
                                    }
                                }
                            }

                            let mut clicked_win_idx = None;
                            for i in (0..self.windows.len()).rev() {
                                if self.windows[i].bounds.contains(self.mouse_x, self.mouse_y) {
                                    clicked_win_idx = Some(i);
                                    break;
                                }
                            }

                            if let Some(idx) = clicked_win_idx {
                                let win = self.windows.remove(idx);
                                self.windows.push(win);
                                let last_idx = self.windows.len() - 1;
                                self.active_window_idx = Some(last_idx);

                                let win_ref = self.windows.last_mut().unwrap();
                                let tb_h = theme.pt(32.0);
                                let win_bx = win_ref.bounds.x;
                                let win_by = win_ref.bounds.y;

                                if self.mouse_y >= win_by && self.mouse_y <= win_by + tb_h {
                                    if self.mouse_x >= win_bx + theme.pt(12.0) && self.mouse_x <= win_bx + theme.pt(24.0) {
                                        self.windows.pop();
                                        self.active_window_idx = self.windows.len().checked_sub(1);
                                        theme::redraw_fullscreen();
                                        continue;
                                    }
                                    self.dragging_window = Some((last_idx, self.mouse_x - win_bx, self.mouse_y - win_by));
                                } else {
                                    win_ref.widget.handle_mouse(self.mouse_x, self.mouse_y, true);
                                }
                                theme::redraw_fullscreen();
                            }
                        } else {
                            self.dragging_window = None;
                            self.resizing_window = None;
                            if let Some(idx) = self.active_window_idx {
                                if idx < self.windows.len() {
                                    self.windows[idx].widget.handle_mouse(self.mouse_x, self.mouse_y, false);
                                }
                            }
                        }
                    }
                    3 => {
                        let keycode = (ev[1] & 0xFF) as u8;
                        let mods = ((ev[1] >> 8) & 0xFF) as u8;
                        if let Some(idx) = self.active_window_idx {
                            if idx < self.windows.len() {
                                self.windows[idx].widget.handle_key(keycode, mods);
                            }
                        }
                    }
                    4 => {
                        let c = char::from_u32(ev[1] as u32).unwrap_or('\0');
                        if c != '\0' {
                            if let Some(idx) = self.active_window_idx {
                                if idx < self.windows.len() {
                                    self.windows[idx].widget.handle_char(c);
                                }
                            }
                        }
                    }
                    5 => {
                        let dy = ev[1] as i64 as i32;
                        if let Some(idx) = self.active_window_idx {
                            if idx < self.windows.len() {
                                self.windows[idx].widget.handle_scroll(self.mouse_x, self.mouse_y, dy);
                            }
                        }
                    }
                    _ => {}
                }
            }

            let theme = get_theme();

            if let Some((wp_px, wp_w, wp_h)) = unsafe { theme::DESKTOP_WALLPAPER.as_ref() } {
                for y in 0..self.height {
                    let sy = y % *wp_h;
                    let s_row = sy * *wp_w;
                    let d_row = y * self.width;
                    for x in 0..self.width {
                        let sx = x % *wp_w;
                        screen_buffer[d_row + x] = wp_px[s_row + sx];
                    }
                }
            } else {
                screen_buffer.fill(0xFF0F172A);
            }

            let mut font_cache = std::collections::BTreeMap::new();
            let mut canvas = Canvas::new(&mut screen_buffer, self.width, self.height, None, &mut font_cache);

            let bar_h = theme.pt(28.0);
            canvas.draw_rect(0, 0, self.width as i32, bar_h, 0xEE1E293B, 0);
            canvas.draw_line_h(0, bar_h, self.width as i32, 0xFF334155);
            canvas.draw_text(theme.pt(16.0), theme.pt(5.0), "EOS Desktop", 0xFFFFFFFF, theme.font_body());

            for win in self.windows.iter_mut() {
                if win.is_minimized { continue; }

                let tb_h = theme.pt(32.0);
                let wb = win.bounds;

                canvas.draw_rect(wb.x, wb.y, wb.w, tb_h, 0xFF1E293B, 6);
                canvas.draw_rect_outline(wb.x, wb.y, wb.w, tb_h, 0xFF334155, 6);

                canvas.draw_rect(wb.x + theme.pt(12.0), wb.y + theme.pt(10.0), theme.pt(12.0), theme.pt(12.0), 0xFFEF4444, 6);
                canvas.draw_rect(wb.x + theme.pt(30.0), wb.y + theme.pt(10.0), theme.pt(12.0), theme.pt(12.0), 0xFFF59E0B, 6);
                canvas.draw_rect(wb.x + theme.pt(48.0), wb.y + theme.pt(10.0), theme.pt(12.0), theme.pt(12.0), 0xFF10B981, 6);

                canvas.draw_text(wb.x + theme.pt(72.0), wb.y + theme.pt(7.0), &win.title, 0xFFF1F5F9, theme.font_body());

                let content_y = wb.y + tb_h;
                let content_h = wb.h - tb_h;
                win.widget.layout(wb.x, content_y, wb.w, content_h);
                win.widget.paint(&mut canvas);

                canvas.draw_rect_outline(wb.x, wb.y, wb.w, wb.h, 0xFF334155, 6);
            }

            let dock_count = self.dock_apps.len() as i32;
            let item_sz = theme.pt(56.0);
            let dock_pad = theme.pt(10.0);
            let dock_w = (dock_count * item_sz) + ((dock_count + 1) * dock_pad);
            let dock_h = item_sz + (dock_pad * 2);
            let dock_x = ((self.width as i32) - dock_w) / 2;
            let dock_y = (self.height as i32) - dock_h - theme.pt(12.0);

            canvas.draw_rect(dock_x, dock_y, dock_w, dock_h, 0xDD1E293B, 16);
            canvas.draw_rect_outline(dock_x, dock_y, dock_w, dock_h, 0xFF475569, 16);

            for (idx, _) in self.dock_apps.iter().enumerate() {
                let cx = dock_x + dock_pad + (idx as i32 * (item_sz + dock_pad)) + (item_sz / 2);
                let cy = dock_y + (dock_h / 2);
                self.draw_dock_icon(&mut canvas, cx, cy, item_sz, idx);
            }

            for cy in 0..22 {
                let py = self.mouse_y as usize + cy;
                if py >= self.height { break; }
                for cx in 0..15 {
                    let px = self.mouse_x as usize + cx;
                    if px >= self.width { break; }
                    if cx <= (cy * 2) / 3 && (cx + cy) < 24 {
                        let is_border = cx == 0 || cx == (cy * 2) / 3 || (cx + cy) >= 22;
                        let color = if is_border { 0xFF000000 } else { 0xFFFFFFFF };
                        canvas.draw_rect(px as i32, py as i32, 1, 1, color, 0);
                    }
                }
            }

            sys_present(screen_buffer.as_ptr(), self.width, self.height);
        }
    }
}
