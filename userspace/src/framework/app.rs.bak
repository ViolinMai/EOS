use std::collections::BTreeMap;
use rusttype::Font;
use crate::apps::*;
use crate::framework::*;
use crate::net_manager::poll_network;
use crate::syscall::{sys_poll_event, sys_present};

pub struct WindowWrapper {
    pub id: usize,
    pub title: String,
    pub bounds: Rect,
    pub widget: Box<dyn Widget>,
    pub active: bool,
    pub dragging: bool,
    pub drag_off_x: usize,
    pub drag_off_y: usize,
}

pub struct FrameworkApp<'a> {
    pub buffer: Vec<u32>,
    pub width: usize,
    pub height: usize,
    pub font: Option<Font<'a>>,
    pub font_cache: BTreeMap<(usize, char), (usize, usize, isize, isize, usize, Vec<u8>)>,
    pub windows: Vec<WindowWrapper>,
    pub running: bool,
    pub mouse_x: usize,
    pub mouse_y: usize,
    pub dock_items: Vec<(&'static str, &'static str)>,
    pub dock_handler: Option<Box<dyn FnMut(usize)>>,
}

impl<'a> FrameworkApp<'a> {
    pub fn new(font_data: &'a [u8], width: usize, height: usize) -> Self {
        let font = Font::try_from_bytes(font_data);
        Self {
            buffer: vec![0u32; width * height],
            width,
            height,
            font,
            font_cache: BTreeMap::new(),
            windows: Vec::new(),
            running: true,
            mouse_x: width / 2,
            mouse_y: height / 2,
            dock_items: vec![
                ("Finder", "📁"),
                ("Terminal", "⌨️"),
                ("Browser", "🌐"),
                ("Settings", "⚙️"),
                ("Activity Monitor", "📊"),
            ],
            dock_handler: None,
        }
    }

    pub fn set_dock_handler<F: FnMut(usize) + 'static>(&mut self, handler: F) {
        self.dock_handler = Some(Box::new(handler));
    }

    pub fn spawn_app(&mut self, name: &str) {
        let theme = get_theme();
        let win_id = self.windows.len() + 1;
        let mut widget: Box<dyn Widget> = match name {
            "Finder" => Box::new(FinderApp::new()),
            "Terminal" => Box::new(TerminalApp::new()),
            "Browser" => Box::new(BrowserApp::new()),
            "Settings" => Box::new(SettingsApp::new()),
            "Activity Monitor" => Box::new(ActivityMonitorApp::new()),
            _ => return,
        };

        let wx = 120 + (win_id * 30);
        let wy = 80 + (win_id * 25);
        let ww = theme.pt(540.0).max(800);
        let wh = theme.pt(360.0).max(520);

        widget.layout(wx, wy + theme.pt(28.0), ww, wh - theme.pt(28.0));

        for w in &mut self.windows { w.active = false; }
        self.windows.push(WindowWrapper {
            id: win_id,
            title: name.to_string(),
            bounds: Rect { x: wx, y: wy, w: ww, h: wh },
            widget,
            active: true,
            dragging: false,
            drag_off_x: 0,
            drag_off_y: 0,
        });
        println!("[INFO] [APP] Spawned new application window: '{}'", name);
    }

    pub fn run_loop(&mut self) {
        let theme = get_theme();
        let mut last_draw = std::time::Instant::now();

        while self.running {
            poll_network();

            while let Some([ev_type, ev_data]) = sys_poll_event() {
                match ev_type {
                    1 => { // MouseMove
                        let raw_x = (ev_data & 0xFFFF_FFFF) as i32;
                        let raw_y = ((ev_data >> 32) & 0xFFFF_FFFF) as i32;
                        self.mouse_x = (self.mouse_x as i32 + raw_x).clamp(0, (self.width - 1) as i32) as usize;
                        self.mouse_y = (self.mouse_y as i32 + raw_y).clamp(0, (self.height - 1) as i32) as usize;

                        for w in self.windows.iter_mut().rev() {
                            if w.dragging {
                                w.bounds.x = self.mouse_x.saturating_sub(w.drag_off_x);
                                w.bounds.y = self.mouse_y.saturating_sub(w.drag_off_y);
                                w.widget.layout(w.bounds.x, w.bounds.y + theme.pt(28.0), w.bounds.w, w.bounds.h - theme.pt(28.0));
                                break;
                            }
                        }
                    }
                    2 => { // MouseButton
                        let btn = (ev_data & 0xFF) as u8;
                        let pressed = ((ev_data >> 8) & 0x01) == 1;

                        if btn == 0 {
                            if pressed {
                                let dock_h = theme.pt(54.0);
                                let dock_w = self.dock_items.len() * theme.pt(58.0) + theme.pt(20.0);
                                let dock_x = (self.width - dock_w) / 2;
                                let dock_y = self.height - dock_h - theme.pt(12.0);

                                if self.mouse_y >= dock_y && self.mouse_y <= dock_y + dock_h && self.mouse_x >= dock_x && self.mouse_x <= dock_x + dock_w {
                                    let item_idx = (self.mouse_x - dock_x - theme.pt(10.0)) / theme.pt(58.0);
                                    if item_idx < self.dock_items.len() {
                                        let app_name = self.dock_items[item_idx].0;
                                        self.spawn_app(app_name);
                                        continue;
                                    }
                                }

                                let mut hit_idx = None;
                                for (i, w) in self.windows.iter_mut().enumerate().rev() {
                                    if w.bounds.contains(self.mouse_x, self.mouse_y) {
                                        hit_idx = Some(i);
                                        if self.mouse_y <= w.bounds.y + theme.pt(28.0) {
                                            w.dragging = true;
                                            w.drag_off_x = self.mouse_x - w.bounds.x;
                                            w.drag_off_y = self.mouse_y - w.bounds.y;
                                        } else {
                                            w.widget.handle_mouse(self.mouse_x, self.mouse_y, true);
                                        }
                                        break;
                                    }
                                }

                                if let Some(idx) = hit_idx {
                                    for w in &mut self.windows { w.active = false; }
                                    let mut win = self.windows.remove(idx);
                                    win.active = true;
                                    self.windows.push(win);
                                }
                            } else {
                                for w in &mut self.windows {
                                    if w.dragging { w.dragging = false; }
                                    w.widget.handle_mouse(self.mouse_x, self.mouse_y, false);
                                }
                            }
                        }
                    }
                    4 => { // Char
                        let c = (ev_data as u8) as char;
                        for w in self.windows.iter_mut().rev() {
                            if w.active {
                                w.widget.handle_char(c);
                                break;
                            }
                        }
                    }
                    _ => {}
                }
            }

            if last_draw.elapsed().as_millis() >= 16 {
                self.paint_desktop();
                sys_present(self.buffer.as_ptr(), self.width, self.height);
                last_draw = std::time::Instant::now();
            } else {
                std::thread::yield_now();
            }
        }
    }

    fn paint_desktop(&mut self) {
        let theme = get_theme();
        let width = self.width;
        let height = self.height;

        let mut canvas = Canvas::new(
            &mut self.buffer,
            width,
            height,
            self.font.as_ref(),
            &mut self.font_cache,
        );

        canvas.draw_rect(0, 0, width, height, 0xFF0F172A, 0);

        // Menubar
        canvas.draw_rect(0, 0, width, theme.pt(28.0), 0xFF1E293B, 0);
        canvas.draw_line_h(0, theme.pt(28.0), width, 0xFF334155);
        canvas.draw_text(theme.pt(14.0), theme.pt(6.0), " EOS Desktop", 0xFFFFFFFF, theme.font_body());

        // Windows
        for w in &self.windows {
            canvas.draw_rect(w.bounds.x, w.bounds.y, w.bounds.w, w.bounds.h, 0xFFFFFFFF, theme.pt(10.0));
            canvas.draw_rect_outline(w.bounds.x, w.bounds.y, w.bounds.w, w.bounds.h, if w.active { theme.accent } else { 0xFF475569 }, theme.pt(10.0));

            canvas.draw_rect(w.bounds.x, w.bounds.y, w.bounds.w, theme.pt(28.0), 0xFF1E293B, theme.pt(10.0));
            canvas.draw_line_h(w.bounds.x, w.bounds.y + theme.pt(28.0), w.bounds.w, 0xFF334155);
            canvas.draw_text(w.bounds.x + theme.pt(16.0), w.bounds.y + theme.pt(6.0), &w.title, 0xFFFFFFFF, theme.font_caption());

            canvas.draw_rect(w.bounds.x + w.bounds.w - theme.pt(24.0), w.bounds.y + theme.pt(8.0), theme.pt(12.0), theme.pt(12.0), 0xFFEF4444, theme.pt(6.0));

            w.widget.paint(&mut canvas);
        }

        // macOS Dock
        let dock_h = theme.pt(54.0);
        let dock_w = self.dock_items.len() * theme.pt(58.0) + theme.pt(20.0);
        let dock_x = (width - dock_w) / 2;
        let dock_y = height - dock_h - theme.pt(12.0);

        canvas.draw_rect(dock_x, dock_y, dock_w, dock_h, 0xDD1E293B, theme.pt(16.0));
        canvas.draw_rect_outline(dock_x, dock_y, dock_w, dock_h, 0xFF475569, theme.pt(16.0));

        for (i, (name, icon)) in self.dock_items.iter().enumerate() {
            let ix = dock_x + theme.pt(14.0) + (i * theme.pt(58.0));
            let iy = dock_y + theme.pt(8.0);
            canvas.draw_rect(ix, iy, theme.pt(38.0), theme.pt(38.0), 0xFF334155, theme.pt(8.0));
            canvas.draw_text(ix + theme.pt(10.0), iy + theme.pt(8.0), icon, 0xFFFFFFFF, theme.font_body());
        }

        // Mouse Cursor
        let mx = self.mouse_x;
        let my = self.mouse_y;
        for cy in 0..22 {
            let py = my + cy;
            if py >= height { break; }
            for cx in 0..15 {
                let px = mx + cx;
                if px >= width { break; }
                if cx <= (cy * 2) / 3 && (cx + cy) < 24 {
                    let is_border = cx == 0 || cx == (cy * 2) / 3 || (cx + cy) >= 22;
                    self.buffer[py * width + px] = if is_border { 0xFF000000 } else { 0xFFFFFFFF };
                }
            }
        }
    }
}
