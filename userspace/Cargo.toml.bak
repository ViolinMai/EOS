[package]
name = "user_app"
version = "0.1.0"
edition = "2021"

[workspace]

[dependencies]
zune-jpeg = { version = "0.4.13", default-features = false }
rusttype = { version = "0.9.3", default-features = true }
miniz_oxide = { version = "0.7.4", default-features = false, features = ["with-alloc"] }

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
