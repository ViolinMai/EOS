use alloc::vec::Vec;
use core::ptr::addr_of_mut;
use core::sync::atomic::{AtomicBool, Ordering};
use crate::{log_info, log_error};
use crate::drivers::e1000::get_driver;

#[derive(Clone, Copy, Debug)]
pub struct MacAddress(pub [u8; 6]);
#[derive(Clone, Copy, Debug)]
pub struct Ipv4Address(pub [u8; 4]);

pub struct NetworkManager {
    pub active: bool,
    pub mac: MacAddress,
    pub ip: Ipv4Address,
    pub gateway: Ipv4Address,
    pub subnet: Ipv4Address,
    pub tx_packets: usize,
    pub rx_packets: usize,
}

static mut NET_MGR_STORAGE: NetworkManager = NetworkManager {
    active: false,
    mac: MacAddress([0; 6]),
    ip: Ipv4Address([10, 0, 2, 15]),
    gateway: Ipv4Address([10, 0, 2, 2]),
    subnet: Ipv4Address([255, 255, 255, 0]),
    tx_packets: 0,
    rx_packets: 0,
};

static NET_LOCK: AtomicBool = AtomicBool::new(false);
static mut RAW_RX_QUEUE: Vec<Vec<u8>> = Vec::new();
static mut RAW_TX_QUEUE: Vec<Vec<u8>> = Vec::new();

#[inline(always)]
fn lock_net() {
    while NET_LOCK.compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {
        core::hint::spin_loop();
    }
}

#[inline(always)]
fn unlock_net() {
    NET_LOCK.store(false, Ordering::Release);
}

pub fn enqueue_rx(packet: Vec<u8>) {
    lock_net();
    unsafe {
        let q = &mut *addr_of_mut!(RAW_RX_QUEUE);
        if q.len() < 256 {
            q.push(packet);
        }
    }
    unlock_net();
}

pub fn dequeue_rx() -> Option<Vec<u8>> {
    lock_net();
    let res = unsafe {
        let q = &mut *addr_of_mut!(RAW_RX_QUEUE);
        if !q.is_empty() {
            Some(q.remove(0))
        } else {
            None
        }
    };
    unlock_net();
    res
}

pub fn enqueue_tx(packet: Vec<u8>) {
    lock_net();
    unsafe {
        let q = &mut *addr_of_mut!(RAW_TX_QUEUE);
        if q.len() < 256 {
            q.push(packet);
        }
    }
    unlock_net();
}

pub fn drain_tx() -> Vec<Vec<u8>> {
    lock_net();
    let res = unsafe {
        let q = &mut *addr_of_mut!(RAW_TX_QUEUE);
        if !q.is_empty() {
            core::mem::take(q)
        } else {
            Vec::new()
        }
    };
    unlock_net();
    res
}

#[inline(always)]
fn get_mgr_mut() -> &'static mut NetworkManager {
    unsafe { &mut *addr_of_mut!(NET_MGR_STORAGE) }
}

#[inline(always)]
pub fn get_mgr() -> &'static NetworkManager {
    unsafe { &*core::ptr::addr_of!(NET_MGR_STORAGE) }
}

pub fn get_mac() -> [u8; 6] {
    get_mgr().mac.0
}

pub fn init() {
    if let Some(e1k) = get_driver() {
        let mgr = get_mgr_mut();
        mgr.active = true;
        mgr.mac = MacAddress(e1k.read_mac());
        log_info!("NET", "Raw Packet Bridge Active. Bound to E1000 NIC.");
        log_info!("NET", "MAC: {:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}",
            mgr.mac.0[0], mgr.mac.0[1], mgr.mac.0[2],
            mgr.mac.0[3], mgr.mac.0[4], mgr.mac.0[5]
        );
    } else {
        log_error!("NET", "No E1000 NIC found. Network disabled.");
    }
}

pub fn poll() {
    if !get_mgr().active { return; }
    if let Some(e1k) = get_driver() {
        while let Some(packet) = e1k.receive_packet() {
            get_mgr_mut().rx_packets += 1;
            enqueue_rx(packet);
        }
        let tx_packets = drain_tx();
        for packet in tx_packets {
            e1k.send_packet(&packet);
            get_mgr_mut().tx_packets += 1;
        }
    }
}

pub fn cmd_ipconfig() {
    let mgr = get_mgr();
    log_info!("NET", "=== EOS RAW NETWORK BRIDGE STATUS ===");
    if mgr.active {
        log_info!("NET", "Interface : eth0 (QEMU Intel E1000)");
        log_info!("NET", "State     : UP (Userspace Managed)");
        log_info!("NET", "MAC Addr  : {:02X}:{:02X}:{:02X}:{:02X}:{:02X}:{:02X}",
            mgr.mac.0[0], mgr.mac.0[1], mgr.mac.0[2],
            mgr.mac.0[3], mgr.mac.0[4], mgr.mac.0[5]);
        log_info!("NET", "Traffic   : RX {} packets | TX {} packets", mgr.rx_packets, mgr.tx_packets);
    } else {
        log_info!("NET", "State     : DOWN / UNINITIALIZED");
    }
}
